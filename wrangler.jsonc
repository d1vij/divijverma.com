{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "divijverma-site",
    "compatibility_date": "2026-06-07",
    "compatibility_flags": ["nodejs_als"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare",
    },
    "workers_dev": true,
    "preview_urls": true,
    "route": {
        "custom_domain": true,
        "pattern": "divijverma.com",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "DB",
            "database_id": "f603ff49-c802-4749-81b7-350fbfc196a8",
        },
    ],
}
